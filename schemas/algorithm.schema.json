{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://akr.local/schemas/algorithm.schema.json",
  "title": "AKR Algorithm Metadata",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "status",
    "asset_type",
    "purpose",
    "inputs",
    "outputs",
    "evidence_states",
    "stop_conditions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ALG-[A-Z]+-[0-9]{3}$"
    },
    "name": {"type": "string", "minLength": 1},
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["draft", "experimental", "validated", "deprecated", "superseded"]
    },
    "asset_type": {"const": "algorithm"},
    "domain": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "purpose": {"type": "string", "minLength": 1},
    "non_goals": {
      "type": "array",
      "items": {"type": "string"}
    },
    "inputs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "outputs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "evidence_states": {
      "type": "array",
      "items": {
        "enum": [
          "OBSERVED",
          "VERIFIED",
          "INFERRED",
          "HYPOTHESIS",
          "SCENARIO",
          "UNKNOWN"
        ]
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": {"type": "string"}
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "supersedes": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": true
}
